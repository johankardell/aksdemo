{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.36.1.42791",
      "templateHash": "11961995786233759712"
    }
  },
  "parameters": {
    "name": {
      "type": "string",
      "metadata": {
        "description": "Name of the AKS cluster"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for the AKS cluster"
      }
    },
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Environment name for tagging"
      }
    },
    "kubernetesVersion": {
      "type": "string",
      "metadata": {
        "description": "Kubernetes version"
      }
    },
    "systemNodeVmSize": {
      "type": "string",
      "metadata": {
        "description": "VM size for system nodes"
      }
    },
    "userNodeVmSize": {
      "type": "string",
      "metadata": {
        "description": "VM size for user nodes"
      }
    },
    "systemNodeCount": {
      "type": "int",
      "minValue": 1,
      "maxValue": 10,
      "metadata": {
        "description": "Number of system nodes"
      }
    },
    "userNodeCount": {
      "type": "int",
      "minValue": 1,
      "maxValue": 50,
      "metadata": {
        "description": "Number of user nodes"
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Admin username for SSH"
      }
    },
    "sshPublicKey": {
      "type": "securestring",
      "metadata": {
        "description": "SSH public key"
      }
    },
    "subnetId": {
      "type": "string",
      "metadata": {
        "description": "Subnet ID for AKS nodes"
      }
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace ID"
      }
    },
    "managedIdentityId": {
      "type": "string",
      "metadata": {
        "description": "Managed identity ID"
      }
    },
    "dnsPrefix": {
      "type": "string",
      "defaultValue": "[parameters('name')]",
      "metadata": {
        "description": "DNS prefix for the cluster"
      }
    },
    "serviceCidr": {
      "type": "string",
      "defaultValue": "172.16.0.0/16",
      "metadata": {
        "description": "Service CIDR for Kubernetes services"
      }
    },
    "dnsServiceIP": {
      "type": "string",
      "defaultValue": "172.16.0.10",
      "metadata": {
        "description": "DNS service IP (must be within serviceCidr)"
      }
    },
    "podCidr": {
      "type": "string",
      "defaultValue": "192.168.0.0/16",
      "metadata": {
        "description": "Pod CIDR for overlay networking"
      }
    },
    "maxPods": {
      "type": "int",
      "defaultValue": 250,
      "metadata": {
        "description": "Maximum number of pods per node"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerService/managedClusters",
      "apiVersion": "2024-09-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentName')]",
        "Purpose": "AKS cluster with HAProxy ingress and workload profile"
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityId'))]": {}
        }
      },
      "sku": {
        "name": "Base",
        "tier": "Standard"
      },
      "properties": {
        "dnsPrefix": "[parameters('dnsPrefix')]",
        "kubernetesVersion": "[parameters('kubernetesVersion')]",
        "enableRBAC": true,
        "networkProfile": {
          "networkPlugin": "azure",
          "networkPluginMode": "overlay",
          "networkDataplane": "cilium",
          "networkPolicy": "cilium",
          "serviceCidr": "[parameters('serviceCidr')]",
          "dnsServiceIP": "[parameters('dnsServiceIP')]",
          "loadBalancerSku": "Standard",
          "podCidr": "[parameters('podCidr')]"
        },
        "agentPoolProfiles": [
          {
            "name": "system",
            "count": "[parameters('systemNodeCount')]",
            "vmSize": "[parameters('systemNodeVmSize')]",
            "osDiskSizeGB": 128,
            "osType": "Linux",
            "mode": "System",
            "type": "VirtualMachineScaleSets",
            "vnetSubnetID": "[parameters('subnetId')]",
            "maxPods": "[parameters('maxPods')]",
            "enableAutoScaling": true,
            "minCount": 1,
            "maxCount": 5,
            "nodeLabels": {
              "node-type": "system"
            },
            "nodeTaints": [
              "CriticalAddonsOnly=true:NoSchedule"
            ]
          }
        ],
        "linuxProfile": {
          "adminUsername": "[parameters('adminUsername')]",
          "ssh": {
            "publicKeys": [
              {
                "keyData": "[parameters('sshPublicKey')]"
              }
            ]
          }
        },
        "addonProfiles": {
          "omsAgent": {
            "enabled": true,
            "config": {
              "logAnalyticsWorkspaceResourceID": "[parameters('logAnalyticsWorkspaceId')]"
            }
          },
          "azureKeyvaultSecretsProvider": {
            "enabled": true,
            "config": {
              "enableSecretRotation": "true"
            }
          }
        },
        "autoScalerProfile": {
          "scale-down-delay-after-add": "10m",
          "scale-down-unneeded-time": "10m",
          "scale-down-utilization-threshold": "0.5"
        },
        "securityProfile": {
          "workloadIdentity": {
            "enabled": true
          }
        },
        "oidcIssuerProfile": {
          "enabled": true
        },
        "workloadAutoScalerProfile": {
          "keda": {
            "enabled": true
          }
        },
        "autoUpgradeProfile": {
          "upgradeChannel": "patch",
          "nodeOSUpgradeChannel": "NodeImage"
        }
      }
    },
    {
      "type": "Microsoft.ContainerService/managedClusters/agentPools",
      "apiVersion": "2024-09-01",
      "name": "[format('{0}/{1}', parameters('name'), 'user')]",
      "properties": {
        "count": "[parameters('userNodeCount')]",
        "vmSize": "[parameters('userNodeVmSize')]",
        "osDiskSizeGB": 128,
        "osType": "Linux",
        "mode": "User",
        "type": "VirtualMachineScaleSets",
        "vnetSubnetID": "[parameters('subnetId')]",
        "maxPods": "[parameters('maxPods')]",
        "enableAutoScaling": true,
        "minCount": 1,
        "maxCount": 10,
        "nodeLabels": {
          "node-type": "user"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerService/managedClusters', parameters('name'))]"
      ]
    }
  ],
  "outputs": {
    "clusterName": {
      "type": "string",
      "value": "[parameters('name')]"
    },
    "clusterId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ContainerService/managedClusters', parameters('name'))]"
    },
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('name')), '2024-09-01').fqdn]"
    },
    "kubeletIdentityObjectId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('name')), '2024-09-01').identityProfile.kubeletidentity.objectId]"
    },
    "kubeletIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('name')), '2024-09-01').identityProfile.kubeletidentity.clientId]"
    },
    "oidcIssuerUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerService/managedClusters', parameters('name')), '2024-09-01').oidcIssuerProfile.issuerURL]"
    }
  }
}